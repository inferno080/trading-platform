{
  "name": "trading-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "serve:prod": "vite build && vite preview --port 4173",
    "typecheck": "tsc --noEmit && tsc --noEmit -p cypress",
    "lint": "eslint .",
    "test:ct": "VITE_COVERAGE=true cypress run --component",
    "test:e2e": "cypress run --e2e",
    "cy:open": "cypress open"
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-intl": "^12.1.8"
  },
  "devDependencies": {
    "@cypress/code-coverage": "^4.1.3",
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "axe-core": "^4.14.1",
    "cypress": "^15.21.2",
    "cypress-axe": "^1.7.0",
    "cypress-real-events": "^1.15.1",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-sonarjs": "^4.2.2",
    "globals": "^17.14.0",
    "nyc": "^18.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^6.4.6",
    "vite-plugin-istanbul": "^7.2.1"
  }
}
