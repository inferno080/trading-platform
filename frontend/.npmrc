# Do not install peer dependencies automatically.
# @cypress/code-coverage lists webpack and the Babel loaders as required peers, but they only matter for
# webpack projects, and this one uses Vite. Without this file, npm's default (used on CI) wants those
# packages and `npm ci` fails against the lockfile, while a machine with this setting turned on globally
# installs without them. Setting it here makes every machine and CI behave the same.
legacy-peer-deps=true
