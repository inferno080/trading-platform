{
  "extension": [
    ".ts",
    ".tsx"
  ],
  "include": [
    "src/**/*.{ts,tsx}"
  ],
  "exclude": [
    "src/main.tsx",
    "src/vite-env.d.ts",
    "src/feed/feedWorker.ts"
  ],
  "reporter": [
